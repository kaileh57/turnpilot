diff --git a/msgq/msgq.cc b/msgq/msgq.cc
index d65fc9e..557aae8 100644
--- a/msgq/msgq.cc
+++ b/msgq/msgq.cc
@@ -446,8 +446,8 @@ int msgq_poll(msgq_pollitem_t * items, size_t nitems, int timeout){
   int ms = (timeout == -1) ? 100 : timeout;
 
 #ifdef __APPLE__
-  // On macOS, signals can't interrupt nanosleep, so poll more frequently
-  int poll_ms = std::min(ms, 10);
+  // On macOS, signals can't interrupt nanosleep, so poll more frequently. 1 ms keeps 100 Hz consumers from merging messages
+  int poll_ms = std::min(ms, 1);
   int remaining_ms = ms;
 #else
   int poll_ms = ms;
@@ -478,7 +478,7 @@ int msgq_poll(msgq_pollitem_t * items, size_t nitems, int timeout){
       if (remaining_ms <= 0){
         break;
       }
-      poll_ms = std::min(remaining_ms, 10);
+      poll_ms = std::min(remaining_ms, 1);
       ts.tv_sec = poll_ms / 1000;
       ts.tv_nsec = (poll_ms % 1000) * 1000 * 1000;
     }
